# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# ---- LLM provider: set ONE key. Without any key the app runs in deterministic rules-only mode.
# Free options:
# GEMINI_API_KEY=        # Google AI Studio free tier  -> https://aistudio.google.com/apikey
# GROQ_API_KEY=          # Groq free tier              -> https://console.groq.com/keys
# OPENROUTER_API_KEY=    # OpenRouter ':free' models   -> https://openrouter.ai/keys
# LLM_PROVIDER=ollama    # local Ollama, no key (run: ollama pull qwen2.5:7b)
# Paid option:
# ANTHROPIC_API_KEY=

# Optional overrides
# LLM_PROVIDER=          # anthropic | gemini | groq | openrouter | ollama (auto-detected from the key otherwise)
# MODEL_NAME=            # e.g. gemini-3.8-flash, gemini-flash-latest, llama-3.3-70b-versatile, claude-opus-5-5
# LLM_MODE=rules_only    # force the deterministic path
